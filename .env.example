# Database — use a hosted Postgres provider (Neon, Supabase, or Vercel Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/keit?sslmode=require"

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d

# AES-256 at rest (32 bytes, base64 or 64-char hex) — CNI and sensitive fields
# Generate: openssl rand -base64 32
# DATA_ENCRYPTION_KEY=

# Delivery dispute admin resolution (optional legacy; prefer admin JWT at /admin)
# ADMIN_API_KEY=
# ADMIN_JWT_SECRET=replace-with-a-long-random-admin-jwt-secret
# ADMIN_BOOTSTRAP_SECRET=one-time-secret-to-create-first-admin
# ADMIN_FLOAT_USER_ID=  (wallet user for admin refunds — funded separately)

# KYC — Smile Identity (default) or sumsub via KYC_PROVIDER=sumsub
# KYC_API_KEY=
# KYC_API_URL=
# KYC_WEBHOOK_SECRET=
# CNI_HASH_SECRET=  (or reuse DATA_ENCRYPTION_KEY)

# Mobile SSL certificate pinning (SHA-256 public key hash, production EAS builds)
# EXPO_PUBLIC_SSL_PIN_SHA256=
# Expo app — your deployed Vercel URL (required on phone; web can use relative /api)
EXPO_PUBLIC_API_URL=https://your-app.vercel.app

# Demo merchant for Pay Merchant screen (create a Business in DB, paste id here)
# EXPO_PUBLIC_DEMO_MERCHANT_ID=

# NODE_ENV=development  (Vercel sets production automatically on deploy)
# Never put production API keys in development .env

# Error monitoring — Sentry (see docs/K21-QUALITY-CONTROL.md)
# EXPO_PUBLIC_SENTRY_DSN=https://…@o….ingest.sentry.io/…
# EXPO_PUBLIC_SENTRY_ENABLED=true   # optional: capture errors in local dev
# SENTRY_DSN=https://…@o….ingest.sentry.io/…   # API server (Vercel)
# SENTRY_AUTH_TOKEN=sntrys_…   # EAS Build source maps
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=k21-mobile

# Cron — hourly Kori reserve reconciliation; scheduled jobs (see supabase/README.md)
# CRON_SECRET=
# CRON_API_URL=https://your-app.vercel.app
# ADMIN_USER_ID=  (optional — in-app alerts for integrity failures)

# Julaya — SANDBOX keys for local/dev (NODE_ENV !== production)
# JULAYA_API_KEY_SANDBOX=
# JULAYA_API_URL_SANDBOX=https://sandbox.api.julaya.co/v1

# Julaya — PRODUCTION keys (Vercel production env only)
# JULAYA_API_KEY=
# JULAYA_API_URL_PRODUCTION=https://api.julaya.co/v1
# JULAYA_WEBHOOK_SECRET=
# JULAYA_CALLBACK_URL=https://your-app.vercel.app/api/webhooks/julaya

# LemFi — international (future)
# LEMFI_API_KEY_SANDBOX=
# LEMFI_API_URL_SANDBOX=https://sandbox.api.lemfi.com/v1
# LEMFI_API_KEY=
# LEMFI_API_URL_PRODUCTION=https://api.lemfi.com/v1

# SMS — offline Africa / feature phones (balance by text, receive alerts, OTP)
# Africa's Talking (recommended for WAEMU) OR Twilio — mock mode when unset
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=sandbox
# AFRICASTALKING_SHORT_CODE=  (optional sender ID)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...
# SMS_WEBHOOK_SECRET=  (verify POST /api/webhooks/sms/inbound)
# Inbound webhook URL: https://your-app.vercel.app/api/webhooks/sms/inbound
# Users text SOLDE to check balance without a smartphone
