generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  phone                  String    @unique
  country                String    @default("SN")
  name                   String?
  handle                 String?   @unique
  statusText             String?
  currentSong            String?
  pinnedPhotos           Json?
  arrondissementKey      String?
  arrondissementIcon     String?
  arrondissementName     String?
  avatarEmoji            String?
  avatarUrl              String?   @db.Text
  identityChoice         String?
  otpVerifiedAt          DateTime?
  pinHash                String?
  pinFailedAttempts      Int       @default(0)
  accountLockedAt        DateTime?
  accountLockReason      String?
  frozenByAdminAt        DateTime?
  adminFreezeReason      String?
  lastActivityAt         DateTime?
  cniNumberEnc           String?
  biometricEnabled       Boolean   @default(false)
  stepUpVerifiedAt       DateTime?
  isDiaspora             Boolean   @default(false)
  verificationTier       Int       @default(1)
  verificationStatus     String    @default("phone_only")
  cniVerifiedAt          DateTime?
  addressVerifiedAt      DateTime?
  dateOfBirth            DateTime?
  cniHash                String?   @unique
  smsAlertsEnabled       Boolean   @default(true)
  smsBalanceQueryEnabled Boolean   @default(true)
  email                  String?   @unique
  emailVerifiedAt        DateTime?
  afriId                 String?   @unique
  studentPassSchool      String?
  studentPassStatus      String?
  studentPassRequestedAt DateTime?
  studentPassVerifiedAt  DateTime?
  studentPassExpiresAt   DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  wallet                Wallet?
  koriSent              KoriTransaction[]      @relation("KoriSender")
  koriReceived          KoriTransaction[]      @relation("KoriRecipient")
  roles                 AccountRole[]
  refreshTokens         RefreshToken[]
  notifications         Notification[]
  ledgerEntries         LedgerEntry[]
  sellerProfile         SellerProfile?
  driverProfile         DriverProfile?
  businessMemberships   BusinessMember[]
  ownedBusinesses       Business[]             @relation("BusinessOwner")
  sentMessages          MboloMessage[]
  mboloMemberships      MboloMember[]
  createdThreads        MboloThread[]          @relation("ThreadCreator")
  createdTontines       TontineGroup[]         @relation("TontineCreator")
  tontineMemberships    TontineMembership[]
  createdEvents         Event[]                @relation("EventPromoter")
  tickets               Ticket[]
  deliveryAssignments   DeliveryTask[]         @relation("AssignedDriver")
  moneyRequestsSent     MoneyRequest[]         @relation("MoneyRequester")
  moneyRequestsReceived MoneyRequest[]         @relation("MoneyPayer")
  railTransactions      RailTransaction[]
  apiIdempotencyKeys    ApiIdempotency[]
  apiAuditLogs          ApiAuditLog[]
  rateLimit             UserRateLimit?
  devices               UserDevice[]
  heldTransactions      HeldTransaction[]
  fraudAlerts           FraudAlert[]
  cniVerificationJobs   CniVerificationJob[]
  dailyUsage            UserDailyUsage[]
  smsMessages           SmsMessage[]
  supportTickets        SupportTicket[]
  supportTicketMessages SupportTicketMessage[]
  adminRefundsReceived  AdminRefund[]          @relation("RefundRecipient")
  transferUndosSent     TransferUndo[]         @relation("UndoSender")
  transferUndosReceived TransferUndo[]         @relation("UndoRecipient")
  payrollEmployments    PayrollEmployee[]      @relation("PayrollEmployeeUser")
  schoolChildren        SchoolStudent[]        @relation("SchoolParent")
  farmerDeliveries      FarmerDeliveryLog[]    @relation("FarmerDeliveries")
  verifiedDeliveries    FarmerDeliveryLog[]    @relation("VerifiedDeliveries")
  blocksCreated         UserBlock[]            @relation("Blocker")
  blocksReceived        UserBlock[]            @relation("BlockedUser")
  reportsFiled          ContentReport[]        @relation("Reporter")
  reportsReceived       ContentReport[]        @relation("ReportedUser")
  offlineSyncItems      OfflineSyncQueue[]
  friendsInitiated      UserFriend[]           @relation("FriendUser")
  friendsReceived       UserFriend[]           @relation("FriendTarget")

  @@index([phone])
  @@index([afriId])
  @@index([frozenByAdminAt])
  @@index([verificationTier])
  @@index([handle])
}

model AccountRole {
  id        String   @id @default(cuid())
  userId    String
  role      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  balance     Int      @default(0)
  koriBalance Int      @default(0)
  currency    String   @default("XOF")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]
}

model KoriTransaction {
  id              String   @id @default(cuid())
  senderId        String?
  recipientId     String?
  amountKori      Int
  transactionType String
  status          String   @default("completed")
  reference       String   @unique
  note            String?
  createdAt       DateTime @default(now())

  sender    User? @relation("KoriSender", fields: [senderId], references: [id])
  recipient User? @relation("KoriRecipient", fields: [recipientId], references: [id])

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@index([transactionType])
}

model KoriReserve {
  id                     String    @id @default("global")
  totalKoriInCirculation Int       @default(0)
  totalReserveHeldXof    Int       @default(0)
  conversionsFrozen      Boolean   @default(false)
  lastReconciliationAt   DateTime?
  lastReconciliationOk   Boolean?
  lastMismatchXof        Int       @default(0)
  lastUpdated            DateTime  @updatedAt
}

model LedgerEntry {
  id                 String   @id @default(cuid())
  walletId           String
  userId             String
  type               String
  amount             Int
  counterpartyName   String?
  counterpartyHandle String?
  note               String?
  reference          String   @unique
  createdAt          DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([type])
}

model Business {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  type           String   @default("merchant")
  category       String?
  arrondissement String?
  kebuId         String?  @unique
  description    String?
  address        String?
  lat            Float?
  lng            Float?
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner            User               @relation("BusinessOwner", fields: [ownerId], references: [id])
  members          BusinessMember[]
  products         Product[]
  orders           Order[]
  events           Event[]
  payrollGroups    PayrollGroup[]
  payrollEmployees PayrollEmployee[]
  schoolStudents   SchoolStudent[]
  reviews          Review[]
  schoolFeePeriods SchoolFeePeriod[]
  deliveryLogs     FarmerDeliveryLog[]
  contentReports   ContentReport[]
  blocksReceived   UserBlock[]

  @@index([ownerId])
  @@index([category])
  @@index([type])
}

model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId, role])
  @@index([userId])
}

model SellerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  shopName  String
  category  String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
}

model DriverProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  status       String    @default("offline")
  vehicle      String?
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, lastActiveAt])
}

model Product {
  id          String   @id @default(cuid())
  sellerId    String?
  businessId  String?
  title       String
  description String?
  price       Int
  category    String?
  inventory   Int      @default(0)
  active      Boolean  @default(true)
  flashPrice  Int?
  flashExpiresAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller     SellerProfile? @relation(fields: [sellerId], references: [id])
  business   Business?      @relation(fields: [businessId], references: [id])
  orderItems OrderItem[]

  @@index([sellerId])
  @@index([businessId])
  @@index([category])
}

model Order {
  id              String   @id @default(cuid())
  buyerId         String
  businessId      String?
  status          String   @default("pending")
  totalAmount     Int
  deliveryAddress String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business?     @relation(fields: [businessId], references: [id])
  items    OrderItem[]
  delivery DeliveryTask?

  @@index([buyerId])
  @@index([businessId])
  @@index([status])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model DeliveryTask {
  id                  String    @id @default(cuid())
  orderId             String    @unique
  buyerId             String
  assignedDriverId    String?
  pickupType          String    @default("merchant")
  pickupLabel         String?
  pickupAddress       String?
  pickupLat           Float?
  pickupLng           Float?
  dropoffArea         String
  dropoffExact        String?
  dropoffLat          Float?
  dropoffLng          Float?
  dropoffAddress      String
  deliveryFeeNational Int       @default(1500)
  riderKoriEarnings   Int       @default(10)
  estimatedMinutes    Int       @default(25)
  status              String    @default("open")
  pickedUpAt          DateTime?
  deliveredAt         DateTime?
  confirmedAt         DateTime?
  buyerRating         Int?
  autoReleaseAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignedDriver User?            @relation("AssignedDriver", fields: [assignedDriverId], references: [id])
  escrow         DeliveryEscrow?
  dispute        DeliveryDispute?

  @@index([assignedDriverId])
  @@index([status])
  @@index([buyerId])
  @@index([autoReleaseAt])
}

model DeliveryEscrow {
  id             String    @id @default(cuid())
  deliveryTaskId String    @unique
  buyerId        String
  riderId        String?
  amountNational Int
  koriPayout     Int
  status         String    @default("reserved")
  reference      String    @unique
  reservedAt     DateTime  @default(now())
  releasedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  delivery DeliveryTask @relation(fields: [deliveryTaskId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([riderId])
  @@index([status])
}

model DeliveryDispute {
  id             String    @id @default(cuid())
  deliveryTaskId String    @unique
  openedByUserId String
  status         String    @default("open")
  holdUntil      DateTime
  resolution     String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  delivery DeliveryTask              @relation(fields: [deliveryTaskId], references: [id], onDelete: Cascade)
  evidence DeliveryDisputeEvidence[]

  @@index([status])
  @@index([holdUntil])
}

model DeliveryDisputeEvidence {
  id        String   @id @default(cuid())
  disputeId String
  userId    String
  type      String
  content   String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  dispute DeliveryDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@index([userId])
}

model Event {
  id          String   @id @default(cuid())
  promoterId  String
  businessId  String?
  title       String
  description String?
  venue       String?
  startsAt    DateTime
  ticketPrice Int
  capacity    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  promoter User      @relation("EventPromoter", fields: [promoterId], references: [id])
  business Business? @relation(fields: [businessId], references: [id])
  tickets  Ticket[]

  @@index([promoterId])
  @@index([startsAt])
}

model Ticket {
  id        String   @id @default(cuid())
  eventId   String
  buyerId   String
  quantity  Int
  amount    Int
  status    String   @default("paid")
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  buyer User  @relation(fields: [buyerId], references: [id])

  @@index([eventId])
  @@index([buyerId])
}

model MboloThread {
  id        String   @id @default(cuid())
  creatorId String
  name      String?
  type      String   @default("direct")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator  User           @relation("ThreadCreator", fields: [creatorId], references: [id])
  members  MboloMember[]
  messages MboloMessage[]

  @@index([creatorId])
  @@index([type])
}

model MboloMember {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())

  thread MboloThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
}

model MboloMessage {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  body      String   @default("")
  kind      String   @default("text")
  mediaUrl  String?  @db.Text
  createdAt DateTime @default(now())

  thread MboloThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User        @relation(fields: [senderId], references: [id])

  @@index([threadId, createdAt])
  @@index([senderId])
}

model TontineGroup {
  id              String    @id @default(cuid())
  name            String
  amountPerMember Int
  frequency       String
  createdBy       String
  potBalance      Int       @default(0)
  rotationIndex   Int       @default(0)
  active          Boolean   @default(true)
  nextDueAt       DateTime?
  lastProcessedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  creator     User                @relation("TontineCreator", fields: [createdBy], references: [id])
  memberships TontineMembership[]

  @@index([createdBy])
  @@index([active, nextDueAt])
}

model TontineMembership {
  id                String   @id @default(cuid())
  groupId           String
  userId            String
  rotationOrder     Int
  hasReceivedPayout Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  group TontineGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MoneyRequest {
  id           String    @id @default(cuid())
  requesterId  String
  payerId      String
  amount       Int
  currency     String    @default("national")
  note         String?
  voiceNoteUrl String?
  status       String    @default("pending")
  reference    String    @unique
  respondedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  requester User @relation("MoneyRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  payer     User @relation("MoneyPayer", fields: [payerId], references: [id], onDelete: Cascade)

  @@index([requesterId, status, createdAt])
  @@index([payerId, status, createdAt])
}

model RailTransaction {
  id             String    @id @default(cuid())
  userId         String
  provider       String    @default("julaya")
  direction      String
  amount         Int
  operator       String?
  phone          String?
  status         String    @default("pending")
  externalId     String?
  reference      String    @unique
  idempotencyKey String?   @unique
  walletDebited  Boolean   @default(false)
  failureReason  String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([provider, externalId])
  @@index([status])
}

model ApiIdempotency {
  id           String   @id @default(cuid())
  key          String   @unique
  provider     String
  userId       String
  operation    String
  reference    String?
  status       String   @default("pending")
  responseJson String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@index([reference])
}

model ApiAuditLog {
  id         String   @id @default(cuid())
  userId     String?
  method     String
  path       String
  statusCode Int?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model UserRateLimit {
  userId       String    @id
  windowStart  DateTime
  requestCount Int       @default(0)
  blockedUntil DateTime?
  flagCount    Int       @default(0)
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserDevice {
  id          String    @id @default(cuid())
  userId      String
  deviceId    String
  deviceName  String?
  ip          String?
  countryCode String?
  verifiedAt  DateTime?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, lastSeenAt])
}

model HeldTransaction {
  id             String    @id @default(cuid())
  userId         String
  operationType  String
  status         String    @default("pending_review")
  amountNational Int
  payloadJson    String
  flagsJson      String
  userMessage    String
  reviewNote     String?
  reviewedBy     String?
  reviewedAt     DateTime?
  reference      String    @unique
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fraudAlerts FraudAlert[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([expiresAt])
}

model FraudAlert {
  id                String    @id @default(cuid())
  userId            String
  heldTransactionId String?
  severity          String    @default("high")
  code              String
  message           String
  acknowledgedAt    DateTime?
  createdAt         DateTime  @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  heldTransaction HeldTransaction? @relation(fields: [heldTransactionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([heldTransactionId])
  @@index([acknowledgedAt])
}

model CniVerificationJob {
  id                  String    @id @default(cuid())
  userId              String
  provider            String
  externalJobId       String?
  status              String    @default("pending")
  verifiedLegalName   String?
  verifiedDateOfBirth DateTime?
  documentNumberHash  String?
  failureReason       String?
  submittedAt         DateTime  @default(now())
  completedAt         DateTime?
  imagesPurgedAt      DateTime?
  purgeImagesAt       DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([externalJobId])
  @@index([purgeImagesAt])
}

model UserDailyUsage {
  userId          String
  usageDate       String
  sentNational    Int      @default(0)
  cashOutNational Int      @default(0)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, usageDate])
}

/**
 * Audit log for inbound/outbound SMS — balance queries, receive alerts, OTP.
 */
model SmsMessage {
  id         String   @id @default(cuid())
  userId     String?
  phone      String
  direction  String
  body       String
  provider   String?
  externalId String?
  status     String   @default("queued")
  purpose    String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([userId, createdAt])
  @@index([purpose, createdAt])
}

/**
 * Immutable audit trail for cron reports, integrity alerts, compliance.
 */
model SecureLog {
  id          String   @id @default(cuid())
  category    String
  severity    String   @default("info")
  title       String
  payloadJson String
  createdAt   DateTime @default(now())

  @@index([category, createdAt])
  @@index([severity, createdAt])
}

/**
 * Separate admin operators — not linked to app User accounts.
 */
model AdminUser {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String?
  totpSecretEnc   String?
  totpEnabled     Boolean   @default(false)
  totpConfirmedAt DateTime?
  active          Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions  AdminSession[]
  auditLogs AdminAuditLog[]
  tickets   SupportTicket[]        @relation("TicketAssignee")
  messages  SupportTicketMessage[]
  refunds   AdminRefund[]

  @@index([active])
}

model AdminSession {
  id           String    @id @default(cuid())
  adminUserId  String
  tokenHash    String    @unique
  totpVerified Boolean   @default(false)
  expiresAt    DateTime
  revokedAt    DateTime?
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  admin AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String?
  targetId    String?
  detailJson  String?
  createdAt   DateTime @default(now())

  admin AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
}

model SupportTicket {
  id              String   @id @default(cuid())
  userId          String
  subject         String
  status          String   @default("open")
  priority        String   @default("normal")
  assignedAdminId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignee AdminUser?             @relation("TicketAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages SupportTicketMessage[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([assignedAdminId])
}

model SupportTicketMessage {
  id            String   @id @default(cuid())
  ticketId      String
  authorType    String
  authorAdminId String?
  authorUserId  String?
  body          String
  createdAt     DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  admin  AdminUser?    @relation(fields: [authorAdminId], references: [id], onDelete: SetNull)
  user   User?         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

/**
 * Admin-issued refunds — always via ledger transfer, never direct balance patch.
 */
model AdminRefund {
  id              String   @id @default(cuid())
  adminUserId     String
  recipientUserId String
  amount          Int
  currency        String   @default("national")
  reason          String
  ledgerReference String   @unique
  originalRef     String?
  status          String   @default("completed")
  createdAt       DateTime @default(now())

  admin     AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  recipient User      @relation("RefundRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt])
  @@index([adminUserId, createdAt])
}

/**
 * 60-second undo window for P2P and merchant payments — reversal is atomic.
 */
model TransferUndo {
  id                 String    @id @default(cuid())
  senderUserId       String
  recipientUserId    String
  amount             Int
  currency           String    @default("national")
  operationType      String    @default("send")
  originalReference  String    @unique
  recipientReference String
  reversibleUntil    DateTime
  status             String    @default("active")
  reversedAt         DateTime?
  reversedReference  String?   @unique
  createdAt          DateTime  @default(now())

  sender    User @relation("UndoSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipient User @relation("UndoRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([senderUserId, status])
  @@index([recipientUserId])
  @@index([reversibleUntil])
}

/** Payroll group — HR, corporate, staff, farmers, etc. */
model PayrollGroup {
  id               String   @id @default(cuid())
  businessId       String
  name             String
  defaultPayAmount Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employees PayrollEmployee[]

  @@index([businessId])
}

/** Employee on a business payroll (includes cooperative farmers). */
model PayrollEmployee {
  id            String    @id @default(cuid())
  businessId    String
  userId        String
  groupId       String?
  jobTitle      String?
  payAmount     Int?
  paySchedule   String    @default("manual")
  payDayOfWeek  Int?
  payDayOfMonth Int?
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User          @relation("PayrollEmployeeUser", fields: [userId], references: [id], onDelete: Cascade)
  group    PayrollGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  payRuns  PayrollRun[]

  @@unique([businessId, userId])
  @@index([businessId, status])
  @@index([userId])
  @@index([groupId])
}

/** Record of a payroll payment. */
model PayrollRun {
  id          String    @id @default(cuid())
  businessId  String
  employeeId  String
  amount      Int
  status      String    @default("completed")
  reference   String    @unique
  note        String?
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  employee PayrollEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([employeeId, createdAt])
}

/** Student enrolled at a school institution. */
model SchoolStudent {
  id           String   @id @default(cuid())
  businessId   String
  studentName  String
  parentUserId String
  gradeLabel   String?
  externalId   String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent   User                @relation("SchoolParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  payments SchoolFeePayment[]

  @@index([businessId, status])
  @@index([parentUserId])
}

/** Monthly or term fee period for a school. */
model SchoolFeePeriod {
  id         String   @id @default(cuid())
  businessId String
  label      String
  amount     Int
  dueDate    DateTime
  status     String   @default("open")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payments SchoolFeePayment[]

  @@index([businessId, status])
  @@index([dueDate])
}

/** Parent fee payment for a student in a period. */
model SchoolFeePayment {
  id             String    @id @default(cuid())
  periodId       String
  studentId      String
  parentUserId   String
  amount         Int
  status         String    @default("pending")
  paidAt         DateTime?
  ledgerReference String?  @unique
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  period  SchoolFeePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  student SchoolStudent   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([periodId, studentId])
  @@index([parentUserId, status])
  @@index([periodId, status])
}

/** Farmer delivery log for cooperatives — verified in person, syncs offline. */
model FarmerDeliveryLog {
  id               String    @id @default(cuid())
  businessId       String
  farmerUserId     String
  quantityTons     Float
  periodStart      DateTime
  periodEnd        DateTime
  verifiedByUserId String?
  verifiedAt       DateTime?
  status           String    @default("pending")
  note             String?
  offlineClientId  String?   @unique
  payoutReference  String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  farmer     User     @relation("FarmerDeliveries", fields: [farmerUserId], references: [id], onDelete: Cascade)
  verifiedBy User?    @relation("VerifiedDeliveries", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([farmerUserId, createdAt])
}

/** User blocked another user or business. */
model UserBlock {
  id                String   @id @default(cuid())
  blockerId         String
  blockedUserId     String?
  blockedBusinessId String?
  createdAt         DateTime @default(now())

  blocker         User      @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser     User?     @relation("BlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)
  blockedBusiness Business? @relation(fields: [blockedBusinessId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedUserId])
  @@unique([blockerId, blockedBusinessId])
  @@index([blockerId])
}

/** User report — routed to K21 admin review queue. */
model ContentReport {
  id                String   @id @default(cuid())
  reporterId        String
  targetUserId      String?
  targetBusinessId  String?
  category          String
  reason            String
  status            String   @default("open")
  adminNotes        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reporter       User      @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser     User?     @relation("ReportedUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetBusiness Business? @relation(fields: [targetBusinessId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([targetUserId])
  @@index([targetBusinessId])
}

/** Friend link — bidirectional rows (A→B and B→A). */
model UserFriend {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("FriendUser", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendTarget", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

/** Offline-first queue — cooperative delivery logs, etc. */
model OfflineSyncQueue {
  id         String    @id @default(cuid())
  userId     String
  entityType String
  payload    String
  clientId   String    @unique
  syncedAt   DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, syncedAt])
  @@index([entityType])
}

/** K21 Charts — community favorite-song chart. One vote per user per week. */
model ChartSong {
  id          String   @id @default(cuid())
  weekKey     String
  titleKey    String
  title       String
  artist      String
  videoId     String?
  submittedBy String?
  createdAt   DateTime @default(now())

  votes SongVote[]

  @@unique([weekKey, titleKey])
  @@index([weekKey])
}

model SongVote {
  id        String   @id @default(cuid())
  songId    String
  userId    String
  weekKey   String
  createdAt DateTime @default(now())

  song ChartSong @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, weekKey])
  @@index([songId])
}

/** Cached external trending data (YouTube SN music, etc.) refreshed by cron. */
model TrendingCache {
  id        String   @id @default(cuid())
  kind      String
  periodKey String
  rank      Int
  title     String
  meta      String?
  url       String?
  createdAt DateTime @default(now())

  @@unique([kind, periodKey, rank])
  @@index([kind, periodKey])
}

/** Real merchant reviews — one per user per business, no fake ratings ever. */
model Review {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  rating     Int
  text       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
}
