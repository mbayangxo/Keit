# Development environment — copy to .env.local for `vercel dev`
# Use SANDBOX keys only. Never commit real keys.

NODE_ENV=development

DATABASE_URL="postgresql://USER:PASSWORD@HOST/keit?sslmode=require"

JWT_ACCESS_SECRET=dev-access-secret-min-16-chars
JWT_REFRESH_SECRET=dev-refresh-secret-min-16-chars

# Expo app — point at local API (`vercel dev` default) or deployed preview
EXPO_PUBLIC_API_URL=http://localhost:3000

# JULAYA_API_KEY_SANDBOX=
# JULAYA_API_URL_SANDBOX=https://sandbox.api.julaya.co/v1
# JULAYA_CALLBACK_URL=http://localhost:3000/api/webhooks/julaya
